        "##6. Valid Parentheses – Stack
Given a string containing (), {}, and [], determine whether the brackets are properly balanced.
Example: "({[]})" → true \n",
        "\n",
        "def is_valid(s):\n",
        "    stack = []\n",
        "\n",
        "    pairs = {\n",
        "        ')': '(',\n",
        "        '}': '{',\n",
        "        ']': '['\n",
        "    }\n",
        "\n",
        "    for char in s:\n",
        "        if char in \"({[\":\n",
        "            stack.append(char)\n",
        "\n",
        "        elif char in \")}]\":\n",
        "            if not stack or stack[-1] != pairs[char]:\n",
        "                return False\n",
        "\n",
        "            stack.pop()\n",
        "\n",
        "    return len(stack) == 0\n",
        "\n",
        "\n",
        "print(is_valid(\"({[]})\"))"
      ],
