        "##9. Number of Islands – Graph/BFS/DFS
Given a grid containing '1' (land) and '0' (water), count the number of distinct islands.
Example:

1 1 0 0
1 0 0 1
0 0 1 1

Output: 2\n",
        "\n",
        "def num_islands(grid):\n",
        "    if not grid:\n",
        "        return 0\n",
        "\n",
        "    rows = len(grid)\n",
        "    cols = len(grid[0])\n",
        "    count = 0\n",
        "\n",
        "    def dfs(r, c):\n",
        "        if (\n",
        "            r < 0 or r >= rows or\n",
        "            c < 0 or c >= cols or\n",
        "            grid[r][c] == '0'\n",
        "        ):\n",
        "            return\n",
        "\n",
        "        grid[r][c] = '0'\n",
        "\n",
        "        dfs(r + 1, c)\n",
        "        dfs(r - 1, c)\n",
        "        dfs(r, c + 1)\n",
        "        dfs(r, c - 1)\n",
        "\n",
        "    for r in range(rows):\n",
        "        for c in range(cols):\n",
        "\n",
        "            if grid[r][c] == '1':\n",
        "                count += 1\n",
        "                dfs(r, c)\n",
        "\n",
        "    return count\n",
        "\n",
        "\n",
        "grid = [\n",
        "    ['1', '1', '0', '0'],\n",
        "    ['1', '0', '0', '1'],\n",
        "    ['0', '0', '1', '1']\n",
        "]\n",
        "\n",
        "print(num_islands(grid))"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "sLDCMLL1NrVX",
        "outputId": "e90f9918-3fca-4633-e306-c57081d607ba"
      },
      "execution_count": 17,
