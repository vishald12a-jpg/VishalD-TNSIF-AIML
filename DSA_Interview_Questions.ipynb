        "##8. Lowest Common Ancestor of a Binary Tree
Given a binary tree and two nodes p and q, find their lowest common ancestor.\n",
        "\n",
        "def lowest_common_ancestor(root, p, q):\n",
        "    if root is None:\n",
        "        return None\n",
        "\n",
        "    if root == p or root == q:\n",
        "        return root\n",
        "\n",
        "    left = lowest_common_ancestor(\n",
        "        root.left, p, q\n",
        "    )\n",
        "\n",
        "    right = lowest_common_ancestor(\n",
        "        root.right, p, q\n",
        "    )\n",
        "\n",
        "    if left and right:\n",
        "        return root\n",
        "\n",
        "    return left if left else right\n"
      ],
      "metadata": {
        "id": "CF2t5vD8Neu3"
      },
      "execution_count": 15,
