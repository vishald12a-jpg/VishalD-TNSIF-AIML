        "\n",
        "##5. Detect a Cycle in a Linked List – Fast & Slow Pointers
Determine whether a singly linked list contains a cycle. Try solving it with O(1) extra space.\n",
        "\n",
        "class ListNode:\n",
        "    def _init_(self, value):\n",
        "        self.value = value\n",
        "        self.next = None\n",
        "\n",
        "\n",
        "def has_cycle(head):\n",
        "    slow = head\n",
        "    fast = head\n",
        "\n",
        "    while fast and fast.next:\n",
        "        slow = slow.next\n",
        "        fast = fast.next.next\n",
        "\n",
        "        if slow == fast:\n",
        "            return True\n",
        "\n",
        "    return False"
      ],
